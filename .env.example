# Environment Configuration (copy to .env and fill in values)

# Environment
DEBUG=false

# GitHub
GITHUB_TOKEN=github_token_example
GITHUB_ORG=your-org
GITHUB_PROJECT_NAME=your-project
GITHUB_READY_STATUS=Ready
GITHUB_AGENT_LABEL=agent
GITHUB_TOKEN_SECRET_NAME=github-control-api-key
GITHUB_TOKEN_SECRET_VERSION=latest
GITHUB_MCP_TOKEN_ENV=GITHUB_TOKEN
GITHUB_API_MAX_RETRIES=5
GITHUB_API_RETRY_BASE_SECONDS=1.0
GITHUB_API_RETRY_MAX_SECONDS=30.0
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=langsmith_example
LANGSMITH_SECRET_NAME=LANGSMITH_ADS_OPTIMIZATION_KEY
LANGSMITH_SECRET_VERSION=latest
LANGSMITH_PROJECT=appforge-coding-engine
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_LOG_PROMPTS=true
LANGSMITH_LOG_RESPONSES=true
MCP_CONFIG_FILENAME=.mcp.json
MCP_SERVER_NAME=github
CLAUDE_MCP_URL=https://api.githubcopilot.com/mcp
CODEX_MCP_URL=https://api.githubcopilot.com/mcp/
CODEX_CONFIG_PATH=~/.codex/config.toml
APPFORGE_MCP_ENABLED=false
APPFORGE_MCP_URL=
APPFORGE_MCP_SERVER_NAME=appforge-mcp-server
ISSUE_TRACKER_BACKEND=github
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_API_KEY=linear_example_key
LINEAR_API_KEY_SECRET_NAME=linear-api-key
LINEAR_API_KEY_SECRET_VERSION=latest
LINEAR_TEAM_NAME=engineering
LINEAR_DEFAULT_PROJECT_NAME=Main Project
LINEAR_DEFAULT_REPO_OWNER=your-org
LINEAR_DEFAULT_REPO_NAME=your-repo
LINEAR_READY_STATUS=Ready
LINEAR_IN_PROGRESS_STATUS=In Progress
LINEAR_BLOCKED_STATUS=Blocked
LINEAR_DONE_STATUS=Done

# OpenAI / Codex
# For local env secrets, run CLI with: --secrets-backend env
APPFORGE_OPENAI_API_KEY=openai_example
CODEX_MODEL=gpt-4
WEBHOOK_SERVICE_ROLE=both
WEBHOOK_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/appforge-webhooks
PR_REVIEW_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/appforge-pr-review
PLANNING_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/appforge-planner-jobs
PLANNING_ARTIFACTS_BUCKET=appforge-planner-artifacts
PLANNER_API_TOKEN=planner_api_token_example
PR_REVIEW_MAX_ROUNDS=2
PR_REVIEW_CONSENSUS_MODE=strict
PR_REVIEW_TARGET_BRANCH=main
PR_REVIEW_REQUIRE_CHECKS=true
PR_REVIEW_MERGE_METHOD=squash
PR_REVIEW_CODEX_MODEL=gpt-5.1-codex
PR_REVIEW_CODEX_MAX_TOKENS=2500
PR_REVIEW_CODEX_REASONING_EFFORT=high
PR_REVIEW_CLAUDE_MODEL=claude-haiku-4-5
PR_REVIEW_CLAUDE_MAX_TOKENS=3000
PR_REVIEW_DIFF_MAX_CHARS=8000

# Claude
CLAUDE_CODE_ADMIN_API_KEY=anthropic_example

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_FILE=gcp-credentials.json

# Agent Workspace
AGENT_WORKSPACE_ROOT=/tmp/agent-hq
AGENT_WORKSPACE_PROVIDER=legacy
AGENT_PROJECT_SESSION_KEY=
AGENT_ID=ace-dev
AGENT_EXECUTION_MODE=tmux

# CLI Agent Commands
CODEX_CLI_COMMAND=codex --model {model}
CLAUDE_CLI_COMMAND=claude --model {model}

TASK_WAIT_TIMEOUT_SECONDS=0
RESUME_IN_PROGRESS_ISSUES=true

# Cleanup policy
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=1800
CLEANUP_WORKTREE_RETENTION_HOURS=72
CLEANUP_TMUX_RETENTION_HOURS=12
CLEANUP_ONLY_DONE=true
CLEANUP_TMUX_ENABLED=true

# Difficulty-based Model Selection
# Labels: difficulty:easy, difficulty:medium, difficulty:hard
DIFFICULTY_EASY_BACKEND=codex
DIFFICULTY_EASY_MODEL=gpt-5.1-codex
DIFFICULTY_MEDIUM_BACKEND=claude
DIFFICULTY_MEDIUM_MODEL=claude-haiku-4-5
DIFFICULTY_HARD_BACKEND=claude
DIFFICULTY_HARD_MODEL=claude-opus-4-1

# Blocked handling
BLOCKED_ASSIGNEE=your-handle

# Twilio SMS Notifications
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TO_NUMBER=+12345678905
